# =============================================================================
# Vexi Bot — Environment Variables
# =============================================================================
# On Fly.io, set these with:  fly secrets set -a vexi-bot KEY=value
# For local dev: cp .env.example .env, fill it in, then `set -a; source .env`
# =============================================================================

# REQUIRED: Discord bot token from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your-discord-bot-token-here

# REQUIRED: Google Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# REQUIRED: Comma-separated Discord channel IDs where Vexi auto-detects videos
# Right-click a channel in Discord (with Developer Mode on) → Copy Channel ID
VEXI_CHANNELS=1234567890123456789,9876543210123456789

# -----------------------------------------------------------------------------
# v3 multi-agent pipeline
# -----------------------------------------------------------------------------
# Pipeline selector — THE ROLLBACK KILL-SWITCH.
#   legacy     = original single Gemini call + embed reply (v2 behavior)
#   multiagent = v3 extract-then-adjudicate pipeline + conversational reply
# Rollback in prod = `fly secrets set -a vexi-bot VEXI_PIPELINE=legacy`
# (machine restarts in seconds, no redeploy).
VEXI_PIPELINE=legacy

# OPTIONAL BUT RECOMMENDED: Groq API key (free at https://console.groq.com)
# powers Whisper transcription with word-level timestamps — the layer that
# fixes "Manners"/"Menace" mishearings. Unset → Gemini transcribes instead
# (slightly less precise timing).
GROQ_API_KEY=

# OPTIONAL: model overrides. Defaults shown — everything runs on
# gemini-2.5-flash because flash-lite and 2.5-pro return 404 "no longer
# available to new users" on newer API keys. If YOUR key has access, upgrade
# the head model with GEMINI_MODEL_ADJUDICATOR=gemini-2.5-pro. When Google
# retires Gemini 2.5 (announced for Oct 16, 2026), migrate by setting these
# to the 3.x successors — no redeploy needed.
#GEMINI_MODEL_LEGACY=gemini-2.5-flash
#GEMINI_MODEL_VISION=gemini-2.5-flash
#GEMINI_MODEL_WITNESS=gemini-2.5-flash
#GEMINI_MODEL_ADJUDICATOR=gemini-2.5-flash
#GEMINI_MODEL_ADJUDICATOR_FALLBACK=gemini-2.5-flash
#GEMINI_MODEL_TRANSLATE=gemini-2.5-flash

# OPTIONAL: ASR backend: auto (groq if key set, else gemini) | groq | gemini
#VEXI_ASR=auto
#GROQ_ASR_MODEL=whisper-large-v3-turbo

# OPTIONAL: spend brake — max reviews per UTC day across all users. When hit,
# submissions get a friendly "try again tomorrow" instead of burning credit.
# 0 = unlimited. Default 300 (≈ $6-9/day worst case).
#VEXI_DAILY_REVIEW_LIMIT=300

# OPTIONAL: pipeline tuning (defaults shown)
#VEXI_FRAME_FPS=1                 # frames sampled per second
#VEXI_FRAME_MAX_W=768             # frame max width in px
#VEXI_PHASH_THRESHOLD=6           # dedupe similarity (higher = fewer frames)
#VEXI_MAX_FRAMES=45               # cap on frames sent to the vision model
#VEXI_FFMPEG_TIMEOUT_S=120        # kill runaway ffmpeg after this
#VEXI_MAX_CONCURRENT_PIPELINES=2  # RAM/CPU guard on the 1GB VM

# -----------------------------------------------------------------------------
# Existing options
# -----------------------------------------------------------------------------
# OPTIONAL: Discord role ID to ping when a video is auto-detected
# Create a "Coaches" role, right-click → Copy Role ID
COACH_ROLE_ID=

# OPTIONAL: Apify API token for /study fallback when yt-dlp gets rate-limited
# on Instagram/TikTok. Get one at https://console.apify.com/account/integrations
# Without this, /study falls back to telling the user to use lumiscript.manus.space.
APIFY_API_TOKEN=

# OPTIONAL: Override the Apify actor slugs (defaults are sensible)
APIFY_INSTAGRAM_ACTOR=apify/instagram-scraper
APIFY_TIKTOK_ACTOR=clockworks/free-tiktok-scraper

# OPTIONAL: Set to "true" to route the video-bytes download through Apify's
# residential proxy. Use this if you see "Apify scrape OK but CDN download
# blocked: HTTP 403" errors. Costs Apify proxy bandwidth (~$8/GB residential).
# Leave blank/unset to use direct downloads (free, but Instagram CDN may 403).
APIFY_USE_PROXY=

# OPTIONAL: Path to a Netscape-format cookies.txt file for yt-dlp Instagram auth.
# Only needed if you want yt-dlp to authenticate (Apify fallback is usually enough).
INSTAGRAM_COOKIES_FILE=
